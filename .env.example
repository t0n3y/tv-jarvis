# Zugangsdaten. Normalerweise traegt die Fernbedienung sie hier ein
# (Einrichtung + App Store). .env NIEMALS committen oder teilen.

# Passwort der Fernbedienung - setzt der Einrichtungsassistent.
# Leer = Fernbedienung ohne Passwort (nur fuer die allererste Einrichtung).
REMOTE_CONTROL_SECRET=

# App "IServ-Vertretungsplan"
ISERV_USERNAME=
ISERV_PASSWORD=

# App "iCloud Kalender": App-spezifisches Passwort von account.apple.com
ICLOUD_APPLE_ID=
ICLOUD_APP_SPECIFIC_PASSWORD=

# App "ToDos aus Notizen": Geheimwort, das der iPhone-Kurzbefehl mitschickt
TODOS_WEBHOOK_SECRET=

# Nur noetig wenn todos.provider = notion
NOTION_TOKEN=

# App "Jellyfin": Jellyfin -> Dashboard -> API-Schluessel -> "+".
# Bleibt auf dem Pi (Streams/Bilder laufen ueber den Server), nie im Browser.
JELLYFIN_API_KEY=
