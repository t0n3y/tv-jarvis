# Kopieren nach .env und ausfuellen. .env NIEMALS committen oder teilen.

ISERV_USERNAME=
ISERV_PASSWORD=

ICLOUD_APPLE_ID=
# App-spezifisches Passwort, erzeugt unter appleid.apple.com -> Anmelden und Sicherheit
ICLOUD_APP_SPECIFIC_PASSWORD=

# Nur noetig wenn todos.provider = notion
NOTION_TOKEN=

# Shared Secret, das die iOS/Mac-Shortcuts-Automation beim POST an /api/todos/webhook mitschickt
TODOS_WEBHOOK_SECRET=change-me

# Optional: schuetzt die Fernbedienung (/remote.html, POST /api/remote/*).
# Leer lassen = Fernbedienung ohne Passwort nutzbar (ok fuers eigene, vertrauenswuerdige WLAN).
REMOTE_CONTROL_SECRET=

# Fuer die Jellyfin-App der Fernbedienung: Jellyfin -> Dashboard -> API-Schluessel -> "+".
# Bleibt serverseitig (Streams/Bilder laufen ueber den Dashboard-Server), nie im Browser.
JELLYFIN_API_KEY=
