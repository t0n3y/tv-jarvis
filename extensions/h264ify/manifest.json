{
  "manifest_version": 3,
  "name": "Jarvis h264ify",
  "version": "1.0.0",
  "description": "Laesst YouTube auf dem Pi H.264 mit hoechstens 30 fps liefern statt VP9/AV1.",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["h264ify.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
