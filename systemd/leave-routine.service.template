[Unit]
Description=TV-Jarvis Verlassen-Routine (Radio aus, TV aus)
After=network-online.target dashboard.service

[Service]
Type=oneshot
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__RUN_USER__/.Xauthority
ExecStart=__INSTALL_DIR__/.venv/bin/python -m app.routines.leave_routine
User=__RUN_USER__
